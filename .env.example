# ============================================================
# ZeroTouch IAM Agent — Environment Template
# Copy to .env and fill in real values. Do NOT commit .env.
# ============================================================

# --- GCP Project ---
PROJECT_ID=your-gcp-project-id
# Standard GCP SDK env vars (vertexai.Client / google.auth read these)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Firestore (single consolidated database) ---
FIRESTORE_DATABASE=your-firestore-db-name

# --- Vertex AI Search / RAG (data store typically in "global") ---
GCP_LOCATION=global
RAG_ENGINE_ID=your-rag-engine-id
RAG_DATA_STORE_ID=your-rag-datastore-id

# --- Agent Engine (VertexAiSessionService + Memory Bank) ---
AGENT_ENGINE_LOCATION=us-central1
AGENT_ENGINE_DISPLAY_NAME=your-agent-engine-name
AGENT_ENGINE_ID=

# --- A2A Provisioner ---
A2A_PROVISIONER_URL=https://your-provisioner-url.run.app

# --- Pub/Sub ---
IAM_TOPIC_ID=iam-request-topic
APPROVALS_TOPIC_ID=iam-approvals-topic

# --- NLU Classifier (Gemini) ---
NLU_REGION=us-central1
NLU_MODEL=gemini-3.1-flash-lite

# --- Communication / Email ---
SENDER_EMAIL=bot@your-domain.com
APPROVAL_CALLBACK_URL=http://localhost:8080
SA_KEY_PATH=orchestrator_key.json

# --- Secrets (use Secret Manager in production) ---
JWT_SECRET=your-jwt-secret

# --- Server ---
PORT=8080
HOST=0.0.0.0
